<mvc:View controllerName="com.douglas.learningportal.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Shell>

        <App id="app">

            <pages>

                <Page title="{i18n>appTitle}">

                    <content>

                        <!-- Barra de destaque / boas-vindas -->
                        <MessageStrip text="{i18n>welcomeMessage}" type="Success" showIcon="true" class="sapUiMediumMargin" />

                        <!-- Lista de trilhas -->
                        <List id="trilhasList" headerText="{i18n>trilhasHeader}" items="{/Trilhas}" class="sapUiResponsiveMargin">

                            <StandardListItem title="{Titulo}" description="{Descricao}" info="{Status}" infoState="{= ${Status} === 'Concluído' ? 'Success' : (${Status} === 'Em Andamento' ? 'Information' : 'None') }" type="Active" press=".onTrilhaPress" />

                        </List>

                    </content>

                </Page>

            </pages>

        </App>

    </Shell>

</mvc:View>