<!-- Lista de trilhas em cards com busca, filtro por status e navegação para o detalhe -->
<mvc:View controllerName="com.douglas.learningportal.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:core="sap.ui.core">
    <Page id="mainPage" title="{i18n>appTitle}">
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <VBox class="sapUiMediumMarginBottom">
                    <!-- wrapping: no celular (375 px) o título quebra a linha em vez de cortar em "Minha jornada de apre..." (#31) -->
                    <Title text="{i18n>welcomeTitle}" level="H1" titleStyle="H2" wrapping="true" class="sapUiSmallMarginBottom" />
                    <Text text="{i18n>welcomeSubtitle}" />
                </VBox>

                <MessageStrip text="{i18n>welcomeMessage}" type="Information" showIcon="true" class="sapUiMediumMarginBottom" />

                <!-- Resumo da jornada: números calculados dos módulos (model/resumo.js) -->
                <VBox id="summary" visible="{= ${/LoadError} !== true }" class="sapUiMediumMarginBottom">
                    <Title id="summaryTitle" text="{i18n>summaryTitle}" level="H2" titleStyle="H4" class="sapUiSmallMarginBottom" />
                    <FlexBox wrap="Wrap" alignItems="Start">
                        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="{i18n>summaryTracks}" />
                            <ObjectNumber id="kpiTotal" number="{view>/resumo/total}" class="sapMObjectNumberLarge" />
                        </VBox>
                        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="{i18n>filterInProgress}" />
                            <ObjectNumber id="kpiAndamento" number="{view>/resumo/emAndamento}" state="Information" class="sapMObjectNumberLarge" />
                        </VBox>
                        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="{i18n>filterDone}" />
                            <ObjectNumber id="kpiConcluidas" number="{view>/resumo/concluidas}" state="Success" class="sapMObjectNumberLarge" />
                        </VBox>
                        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="{i18n>summaryOverall}" />
                            <ObjectNumber id="kpiGeral" number="{view>/resumo/progressoGeral}" unit="%" class="sapMObjectNumberLarge" />
                        </VBox>
                        <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="{i18n>summaryHours}" />
                            <ObjectNumber id="kpiHoras" number="{view>/resumo/horasFeitas}" unit="{= '/ ' + ${view>/resumo/horasTotal} + ' h' }" class="sapMObjectNumberLarge" />
                        </VBox>
                    </FlexBox>
                    <HBox id="continueBox" alignItems="Center" visible="{= !!${view>/resumo/continuar} }">
                        <Label text="{i18n>summaryContinue}" class="sapUiTinyMarginEnd" />
                        <Link id="continueLink" text="{view>/resumo/continuar/Titulo}" press=".onContinue" />
                    </HBox>
                </VBox>

                <Title id="trilhasTitle" text="{i18n>trilhasHeader}" level="H2" titleStyle="H4" class="sapUiSmallMarginBottom" />

                <OverflowToolbar class="sapUiSmallMarginBottom" style="Clear">
                    <SearchField id="searchField" width="14rem" placeholder="{i18n>searchPlaceholder}" ariaLabelledBy="trilhasTitle" liveChange=".onFilter" search=".onFilter" />
                    <Label id="statusLabel" text="{i18n>statusFilterLabel}" labelFor="statusFilter" />
                    <SegmentedButton id="statusFilter" ariaLabelledBy="statusLabel" selectionChange=".onFilter" selectedKey="all">
                        <items>
                            <SegmentedButtonItem key="all" text="{i18n>filterAll}" />
                            <SegmentedButtonItem key="Em Andamento" text="{i18n>filterInProgress}" />
                            <SegmentedButtonItem key="Não Iniciado" text="{i18n>filterNotStarted}" />
                            <SegmentedButtonItem key="Concluído" text="{i18n>filterDone}" />
                        </items>
                    </SegmentedButton>
                    <Label id="sortLabel" text="{i18n>sortLabel}" labelFor="sortSelect" />
                    <Select id="sortSelect" ariaLabelledBy="sortLabel" selectedKey="catalogo" change=".onSort">
                        <items>
                            <core:Item key="catalogo" text="{i18n>sortCatalog}" />
                            <core:Item key="titulo" text="{i18n>sortTitle}" />
                            <core:Item key="progresso" text="{i18n>sortProgress}" />
                            <core:Item key="horas" text="{i18n>sortHours}" />
                        </items>
                    </Select>
                    <CheckBox id="favoriteOnly" text="{i18n>favoriteOnlyLabel}" select=".onFilter" />
                    <ToolbarSpacer />
                    <Text id="countText" text="{view>/count}" />
                </OverflowToolbar>

                <MessageStrip id="loadError" text="{i18n>loadError}" type="Error" showIcon="true" visible="{= ${/LoadError} === true }" class="sapUiSmallMarginBottom" />

                <IllustratedMessage id="emptyState" illustrationType="sapIllus-NoSearchResults" title="{= ${view>/soFavoritas} &amp;&amp; !${view>/temFavoritas} ? ${i18n>noFavoritesFound} : ${i18n>noTracksFound} }" visible="{= ${view>/total} === 0 &amp;&amp; ${/LoadError} !== true }" />

                <f:GridContainer id="trilhasGrid" items="{/Trilhas}" snapToRow="false" ariaLabelledBy="trilhasTitle">
                    <f:layout>
                        <f:GridContainerSettings columnSize="20rem" gap="1rem" />
                    </f:layout>
                    <f:layoutS>
                        <f:GridContainerSettings columnSize="100%" gap="0.5rem" />
                    </f:layoutS>
                    <f:items>
                        <f:Card width="100%">
                            <f:header>
                                <card:Header title="{Titulo}" subtitle="{ parts: ['Concluidos', 'ModulosCount'], formatter: '.formatter.status' }" iconSrc="sap-icon://learning-assistant" />
                            </f:header>
                            <f:content>
                                <VBox class="sapUiSmallMargin">
                                    <Text text="{Descricao}" maxLines="3" class="sapUiSmallMarginBottom" />
                                    <ProgressIndicator
                                        percentValue="{ parts: ['Concluidos', 'ModulosCount'], formatter: '.formatter.progresso' }"
                                        displayValue="{ parts: ['Concluidos', 'ModulosCount'], formatter: '.formatter.percentual' }"
                                        state="{ parts: ['Concluidos', 'ModulosCount'], formatter: '.formatter.estado' }"
                                        tooltip="{i18n>progressLabel}"
                                        class="sapUiSmallMarginBottom" />
                                    <HBox justifyContent="SpaceBetween">
                                        <ObjectStatus icon="sap-icon://course-book" text="{Concluidos} / {ModulosCount} {i18n>modulesShort}" />
                                        <ObjectStatus icon="sap-icon://history" text="{Horas} h" />
                                    </HBox>
                                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                                        <Button text="{i18n>viewDetailsButton}" type="Emphasized" icon="sap-icon://navigation-right-arrow" iconFirst="false"
                                            tooltip="{Titulo}" press=".onTrilhaPress" />
                                        <!-- Favorito (#18): botão de alternância, como no padrão Flag and Favorite do Fiori -->
                                        <ToggleButton icon="{= ${Favorita} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" pressed="{Favorita}"
                                            tooltip="{= (${Favorita} ? ${i18n>unfavoriteTooltip} : ${i18n>favoriteTooltip}) + ': ' + ${Titulo} }" press=".onFavoritePress" />
                                    </HBox>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </f:items>
                </f:GridContainer>
            </VBox>
        </content>
    </Page>
</mvc:View>
<!-- Fim de Master.view.xml -->
